   env_vars = ENV['PROJECT_ROOT'] ? "PROJECT_ROOT=#{ENV['PROJECT_ROOT']} " : ""
+  # `bash -l -c "$PATH"` makes bash *parse* $PATH as shell source, so a
+  # project path containing shell-special characters (parentheses, etc.)
+  # fails with "syntax error near unexpected token" instead of just running
+  # the script. `bash -l "$PATH"` runs $PATH as a script file directly --
+  # no re-parsing of the path string itself -- which is what was actually
+  # intended here. The env-var prefix still works the same way as a plain
+  # POSIX `VAR=val command` prefix, just ahead of `bash` instead of inside
+  # the (removed) -c string.
   script_phase = {
     :name => 'Generate app.config for prebuilt Constants.manifest',
-    :script => "bash -l -c \"#{env_vars}$PODS_TARGET_SRCROOT/../scripts/get-app-config-ios.sh\"",
