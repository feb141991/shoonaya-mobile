{
  "expo": {
    "name": "Shoonaya",
    "slug": "shoonaya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "shoonaya",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shoonaya.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Shoonaya uses your location to find sacred places and temples nearby."
      },
      "buildNumber": "3"
    },
    "android": {
      "package": "com.shoonaya.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 16,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20",
            "newArchEnabled": true,
            "extraProguardRules": "-keep class expo.modules.** { *; } -keep class com.facebook.react.turbomodule.** { *; } -keep class com.swmansion.gesturehandler.** { *; } -keep class com.swmansion.reanimated.** { *; } -keep class com.facebook.react.** { *; } -keep class kotlin.reflect.** { *; }"
          },
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C5A059",
          "sounds": []
        }
      ],
      "expo-system-ui",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FDF6E3"
        }
      ],
      "expo-web-browser",
      "./plugins/with-firebase-analytics-android",
      [
        "expo-image-picker",
        {
          "photosPermission": "Shoonaya uses your photo library so you can update your profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-image",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aceb15a9-aa70-4db9-b785-961309a12e3f"
      }
    },
    "owner": "rds-ventures"
  }
}
