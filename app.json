{
  "expo": {
    "name": "Shoonaya",
    "slug": "shoonaya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "shoonaya",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF6E3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shoonaya.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Shoonaya uses your location to find sacred places and temples nearby.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Shoonaya uses your location to find sacred places and temples nearby.",
        "NSMicrophoneUsageDescription": "Shoonaya uses your microphone for Sanskrit recitation practice.",
        "NSCameraUsageDescription": "Shoonaya uses your camera to scan sacred QR codes and relics.",
        "NSSpeechRecognitionUsageDescription": "Shoonaya uses speech recognition to evaluate your Sanskrit pronunciation."
      }
    },
    "android": {
      "package": "com.shoonaya.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 11,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C5A059",
          "sounds": []
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      "expo-system-ui",
      "expo-av",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      "expo-web-browser",
      "expo-sharing",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.shoonaya.app.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.shoonaya.app.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "aceb15a9-aa70-4db9-b785-961309a12e3f"
      }
    },
    "owner": "rds-ventures"
  }
}
